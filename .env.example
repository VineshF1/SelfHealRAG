# Self-Healing RAG Pipeline — Environment Configuration
# Copy this file to .env and fill in your values.

# Required: OpenRouter API key (free) from https://openrouter.ai/keys
OPENROUTER_API_KEY=*** Optional: Override the model (default: nvidia/nemotron-3-nano-30b-a3b:free)
# RAG_MODEL=nvidia/nemotron-3-nano-30b-a3b:free

# Optional: Rate limit — max API requests per minute (default: 60)
# RAG_RPM=60
